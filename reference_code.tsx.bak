import React, { useState, useEffect, useRef } from 'react';
import { Trophy, Heart, Star, Sparkles, UserPlus, ChevronRight, ThumbsUp, Check, Award, Search, Menu, X, Upload, Briefcase, ExternalLink, Loader2, AlertCircle, User, Users, Mail } from 'lucide-react';

// SECURITY NOTE: In a production environment, the Airtable API Key should strictly be stored server-side.
// Client-side usage exposes the key to anyone inspecting the network traffic.
// This implementation is for demonstration/prototype purposes only.

// --- AlayaCare Brand Colors & Theme ---
const THEME = {
    colors: {
        deepBlue: '#08193e',    // Primary Deep Blue
        logoBlue: '#101a5c',    // Logo Blue
        vividBlue: '#113cca',   // Vivid Blue
        lightBlue: '#1d5eed',   // Light Blue
        logoOrange: '#f37021',  // Primary Orange
        vividOrange: '#f58220', // Secondary Orange
        gold: '#ffaa05',        // Gold
        grey: '#dadadf',        // Grey
        white: '#fcfcfc',       // ICBIN White
    },
    fonts: {
        main: "Calibre, 'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
        presentation: "Arial, sans-serif",
    }
};

// --- Mock Data (Fallback) ---
const INITIAL_NOMINEES = [
    { id: 1, name: "Sarah Jenkins", category: "Compassion in Care", votes: 42, image: "https://i.pravatar.cc/150?u=1", description: "Went above and beyond to organize a birthday surprise for an isolated patient." },
    // ... other mock data
];

const CATEGORIES = [
    { id: 'compassion', name: "Compassion in Care", icon: Heart, color: THEME.colors.vividOrange, description: "For caregivers who show extraordinary empathy." },
    { id: 'innovation', name: "Innovation Excellence", icon: Sparkles, color: THEME.colors.vividBlue, description: "For finding new, better ways to deliver care." },
    { id: 'rookie', name: "Rookie of the Year", icon: Star, color: THEME.colors.gold, description: "Best newcomer (under 1 year) demonstrating potential." },
    { id: 'lifetime', name: "Lifetime Achievement", icon: Trophy, color: THEME.colors.deepBlue, description: "Honoring long-term dedication and impact." },
];

// --- Helper Components ---

const Button = ({ children, variant = 'primary', className = '', disabled, ...props }) => {
    const baseStyle = "px-6 py-3 rounded-md font-semibold transition-all duration-200 shadow-sm flex items-center justify-center gap-2";

    const style = variant === 'primary'
        ? { backgroundColor: disabled ? THEME.colors.grey : THEME.colors.logoOrange, color: 'white', cursor: disabled ? 'not-allowed' : 'pointer' }
        : variant === 'secondary'
            ? { backgroundColor: 'white', color: THEME.colors.deepBlue, border: `1px solid ${THEME.colors.grey}`, cursor: disabled ? 'not-allowed' : 'pointer' }
            : {};

    return (
        <button
            className={`${baseStyle} ${className}`}
            style={style}
            disabled={disabled}
            {...props}
        >
            {children}
        </button>
    );
};

const Card = ({ children, className = '', onClick }) => (
    <div
        onClick={onClick}
        className={`bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden ${className}`}
    >
        {children}
    </div>
);

const Badge = ({ children, color }) => (
    <span
        className="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-white"
        style={{ backgroundColor: color || THEME.colors.lightBlue }}
    >
        {children}
    </span>
);

// --- Confirmation Result Modal ---
const ConfirmationResultModal = ({ isOpen, onClose, title, message, isSuccess, onViewVotes }) => {
    if (!isOpen) return null;

    return (
        <div className="fixed inset-0 z-[120] flex items-center justify-center bg-black bg-opacity-60 p-4 animate-fade-in">
            <div className="bg-white rounded-lg shadow-2xl w-full max-w-md p-8 text-center relative">
                <button onClick={onClose} className="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
                    <X size={24} />
                </button>

                <div className={`w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-6 ${isSuccess ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600'}`}>
                    {isSuccess ? <Check size={32} /> : <AlertCircle size={32} />}
                </div>

                <h3 className="text-2xl font-bold mb-3" style={{ color: THEME.colors.deepBlue }}>{title}</h3>
                <p className="text-gray-600 mb-8 leading-relaxed">
                    {message}
                </p>

                <div className="flex flex-col gap-3">
                    {isSuccess && onViewVotes && (
                        <Button onClick={onViewVotes} className="w-full">
                            View All Nominees
                        </Button>
                    )}
                    <Button variant="secondary" onClick={onClose} className="w-full">
                        Close
                    </Button>
                </div>
            </div>
        </div>
    );
};

// --- Vote Modal Component ---
const VoteModal = ({ isOpen, onClose, nominee, onSubmit, isChecking, errorMsg, voteCompleted }) => {
    const [email, setEmail] = useState('');

    if (!isOpen || !nominee) return null;

    if (voteCompleted) {
        return (
            <div className="fixed inset-0 z-[100] flex items-center justify-center bg-black bg-opacity-50 p-4">
                <div className="bg-white rounded-lg shadow-xl w-full max-w-md p-8 relative animate-fade-in-up text-center">
                    <Mail size={40} className="text-gray-500 mx-auto mb-4" />
                    <h3 className="text-2xl font-bold mb-2" style={{ color: THEME.colors.deepBlue }}>Verification Required</h3>
                    <p className="text-gray-600 mb-6">
                        Thank you for voting for <strong>{nominee.name}</strong>. Please check your email inbox to finalize your submission. Your vote is pending confirmation.
                    </p>
                    <Button onClick={onClose} className="w-full">
                        Close
                    </Button>
                </div>
            </div>
        );
    }

    return (
        <div className="fixed inset-0 z-[100] flex items-center justify-center bg-black bg-opacity-50 p-4">
            <div className="bg-white rounded-lg shadow-xl w-full max-w-md p-6 relative animate-fade-in-up">
                <button onClick={onClose} className="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
                    <X size={24} />
                </button>

                <h3 className="text-2xl font-bold mb-2" style={{ color: THEME.colors.deepBlue }}>Confirm Your Vote</h3>
                <p className="text-gray-600 mb-6">
                    You are voting for <span className="font-bold text-[#f37021]">{nominee.name}</span>.
                    Please enter your email to verify your vote.
                </p>

                {errorMsg && (
                    <div className="bg-amber-50 border-l-4 border-amber-500 p-4 mb-6 rounded-r flex items-start gap-3">
                        <AlertCircle className="text-amber-500 mt-0.5 shrink-0" size={20} />
                        <p className="text-amber-700 font-medium text-sm">{errorMsg}</p>
                    </div>
                )}

                <form onSubmit={(e) => { e.preventDefault(); onSubmit(email); }}>
                    <div className="mb-6">
                        <label className="block text-sm font-bold mb-2 text-gray-700">Your Email Address</label>
                        <input
                            required
                            type="email"
                            className="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                            style={{ '--tw-ring-color': THEME.colors.logoOrange }}
                            placeholder="e.g. name@company.com"
                            value={email}
                            onChange={(e) => setEmail(e.target.value)}
                        />
                    </div>

                    <div className="flex gap-3">
                        <Button type="submit" className="flex-1" disabled={isChecking}>
                            {isChecking ? (
                                <>
                                    <Loader2 className="animate-spin" size={20} /> Verifying...
                                </>
                            ) : (
                                "Submit Vote"
                            )}
                        </Button>
                        <Button type="button" variant="secondary" onClick={onClose} disabled={isChecking}>
                            Cancel
                        </Button>
                    </div>
                </form>
            </div>
        </div>
    );
};

// --- View Components ---

