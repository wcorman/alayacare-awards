// --- NEW VIEW: Nomination Type Selection ---
const NominationTypeView = ({ setView, setNominationType }) => {
    const handleSelect = (type) => {
        setNominationType(type);
        setView('nominate');
    };

    return (
        <div className="py-20 px-6 lg:px-12 bg-gray-50 min-h-screen flex flex-col items-center">
            <div className="max-w-4xl w-full text-center">
                <button onClick={() => setView('home')} className="flex items-center gap-2 text-gray-500 hover:text-[#f37021] mb-8 font-medium mx-auto md:mx-0">
                    <ChevronRight className="rotate-180" size={20} /> Back to Home
                </button>

                <h2 className="text-3xl font-bold mb-4" style={{ color: THEME.colors.deepBlue }}>Who are you nominating?</h2>
                <p className="text-gray-600 mb-12 max-w-xl mx-auto">
                    You can nominate yourself for your own achievements, or recognize a colleague who has gone above and beyond.
                </p>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
                    {/* Card: Nominate Myself */}
                    <Card
                        onClick={() => handleSelect('self')}
                        className="p-8 cursor-pointer hover:border-2 border-transparent hover:border-[#f37021] transition-all group h-full flex flex-col items-center text-center"
                    >
                        <div className="w-24 h-24 rounded-full bg-blue-50 flex items-center justify-center mb-6 group-hover:bg-blue-100 transition-colors">
                            <User size={48} className="text-[#1d5eed]" />
                        </div>
                        <h3 className="text-2xl font-bold mb-3" style={{ color: THEME.colors.deepBlue }}>Myself</h3>
                        <p className="text-gray-600">
                            I am a caregiver and I want to share my own story of excellence.
                        </p>
                        <div className="mt-8">
                            <span className="text-[#f37021] font-bold group-hover:underline flex items-center gap-2">
                                Continue <ChevronRight size={16} />
                            </span>
                        </div>
                    </Card>

                    {/* Card: Nominate Someone Else */}
                    <Card
                        onClick={() => handleSelect('other')}
                        className="p-8 cursor-pointer hover:border-2 border-transparent hover:border-[#f37021] transition-all group h-full flex flex-col items-center text-center"
                    >
                        <div className="w-24 h-24 rounded-full bg-orange-50 flex items-center justify-center mb-6 group-hover:bg-orange-100 transition-colors">
                            <Users size={48} className="text-[#f37021]" />
                        </div>
                        <h3 className="text-2xl font-bold mb-3" style={{ color: THEME.colors.deepBlue }}>Someone Else</h3>
                        <p className="text-gray-600">
                            I want to nominate a colleague, employee, or friend for their amazing work.
                        </p>
                        <div className="mt-8">
                            <span className="text-[#f37021] font-bold group-hover:underline flex items-center gap-2">
                                Continue <ChevronRight size={16} />
                            </span>
                        </div>
                    </Card>
                </div>
            </div>
        </div>
    );
};

const NominateView = ({ setView, formData, setFormData, handleNominateSubmit, isSubmitting, errorMsg, nominationType }) => {
    const handleImageChange = (e) => {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onloadend = () => {
                setFormData(prev => ({ ...prev, profileImage: reader.result }));
            };
            reader.readAsDataURL(file);
        } else {
            setFormData(prev => ({ ...prev, profileImage: null }));
        }
    };

    const isSelf = nominationType === 'self';

    return (
        <div className="py-12 px-6 lg:px-12 bg-gray-50 min-h-screen">
            <div className="max-w-3xl mx-auto">
                <button onClick={() => setView('nomination-type')} className="flex items-center gap-2 text-gray-500 hover:text-[#f37021] mb-8 font-medium">
                    <ChevronRight className="rotate-180" size={20} /> Back to Selection
                </button>

                <Card className="p-8 md:p-12">
                    <div className="mb-8">
                        <h2 className="text-3xl font-bold mb-2" style={{ color: THEME.colors.deepBlue }}>
                            {isSelf ? "Tell Us Your Story" : "Nominate a Caregiver"}
                        </h2>
                        <p className="text-gray-600">
                            {isSelf ? "You do amazing work. Help us recognize it." : "Shine a light on someone who makes a difference."}
                        </p>
                    </div>

                    <form onSubmit={handleNominateSubmit} className="space-y-6">

                        {/* Field 1: Name */}
                        <div>
                            <label className="block text-sm font-bold mb-2 text-gray-700">
                                {isSelf ? "Your Name" : "Nominee Name"}
                            </label>
                            <input
                                required
                                type="text"
                                className="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                                style={{ '--tw-ring-color': THEME.colors.logoOrange }}
                                placeholder={isSelf ? "e.g. Jane Doe" : "e.g. Jane Doe"}
                                value={formData.nomineeName}
                                onChange={e => setFormData({ ...formData, nomineeName: e.target.value })}
                            />
                        </div>

                        {/* Field 2: Nominee Email */}
                        <div>
                            <label className="block text-sm font-bold mb-2 text-gray-700">
                                {isSelf ? "Your Email" : "Nominee Email"}
                            </label>
                            <input
                                required
                                type="email"
                                className="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                                style={{ '--tw-ring-color': THEME.colors.logoOrange }}
                                placeholder="e.g. jane.doe@careprovider.com"
                                value={formData.nomineeEmail}
                                onChange={e => setFormData({ ...formData, nomineeEmail: e.target.value })}
                            />
                            <p className="text-xs text-gray-500 mt-1">We'll use this to notify {isSelf ? "you" : "them"} if {isSelf ? "you" : "they"} win.</p>
                        </div>

                        {/* Field 3: Photo */}
                        <div>
                            <label className="block text-sm font-bold mb-2 text-gray-700">
                                {isSelf ? "Your Profile Photo (Optional)" : "Nominee Profile Photo (Optional)"}
                            </label>
                            <div className="flex items-center space-x-4">
                                <div className="w-20 h-20 rounded-full bg-gray-200 flex items-center justify-center overflow-hidden border-2 border-dashed" style={{ borderColor: THEME.colors.grey }}>
                                    {formData.profileImage ? (
                                        <img
                                            src={formData.profileImage}
                                            alt="Profile Preview"
                                            className="w-full h-full object-cover"
                                            onError={(e) => { e.target.onerror = null; e.target.src = "https://placehold.co/150x150/dadadf/08193e?text=Photo+Error"; }}
                                        />
                                    ) : (
                                        <UserPlus size={24} className="text-gray-500" />
                                    )}
                                </div>
                                <label className="cursor-pointer">
                                    <input
                                        type="file"
                                        accept="image/*"
                                        className="hidden"
                                        onChange={handleImageChange}
                                    />
                                    <span className="flex items-center gap-2 px-4 py-2 rounded-md font-semibold text-sm transition-all" style={{ backgroundColor: THEME.colors.lightBlue, color: 'white' }}>
                                        <Upload size={16} /> Upload Photo
                                    </span>
                                </label>
                                {formData.profileImage && (
                                    <button
                                        type="button"
                                        onClick={() => setFormData(prev => ({ ...prev, profileImage: null }))}
                                        className="text-red-500 hover:text-red-700 text-sm"
                                    >
                                        Remove
                                    </button>
                                )}
                            </div>
                        </div>

                        {/* Field 4: Category */}
                        <div>
                            <label className="block text-sm font-bold mb-2 text-gray-700">Award Category</label>
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                                {CATEGORIES.map(cat => (
                                    <div
                                        key={cat.id}
                                        onClick={() => setFormData({ ...formData, category: cat.name })}
                                        className={`cursor-pointer p-4 rounded-md border-2 transition-all flex items-center gap-3 ${formData.category === cat.name ? 'bg-orange-50' : 'hover:bg-gray-50'}`}
                                        style={{ borderColor: formData.category === cat.name ? THEME.colors.logoOrange : '#e5e7eb' }}
                                    >
                                        <div className={`w-8 h-8 rounded-full flex items-center justify-center text-white`} style={{ backgroundColor: cat.color }}>
                                            <cat.icon size={16} />
                                        </div>
                                        <span className="font-medium text-sm text-gray-800">{cat.name}</span>
                                        {formData.category === cat.name && <Check size={16} className="ml-auto text-[#f37021]" />}
                                    </div>
                                ))}
                            </div>
                        </div>

                        {/* Field 5: Reason */}
                        <div>
                            <label className="block text-sm font-bold mb-2 text-gray-700">Reason for Nomination</label>
                            <textarea
                                required
                                rows="4"
                                className="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                                style={{ '--tw-ring-color': THEME.colors.logoOrange }}
                                placeholder={isSelf ? "Tell us why you deserve to win..." : "Tell us why this person deserves to win..."}
                                value={formData.description}
                                onChange={e => setFormData({ ...formData, description: e.target.value })}
                            ></textarea>
                        </div>

                        {/* Field 6: Nominator Email (Hidden if Self) */}
                        {!isSelf && (
                            <div>
                                <label className="block text-sm font-bold mb-2 text-gray-700">Your Email (Required for submission)</label>
                                <input
                                    required
                                    type="email"
                                    className="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:border-transparent transition-all"
                                    style={{ '--tw-ring-color': THEME.colors.logoOrange }}
                                    placeholder="So we can contact you if they win"
                                    value={formData.email}
                                    onChange={e => setFormData({ ...formData, email: e.target.value })}
                                />
                            </div>
                        )}

                        {/* Industry Checkbox - Only appears if NOT self-nominating */}
                        {!isSelf && (
                            <div className="flex items-center gap-3 p-4 bg-blue-50 rounded-md border border-blue-100">
                                <input
                                    type="checkbox"
                                    id="industryCheckbox"
                                    className="w-5 h-5 rounded text-[#f37021] focus:ring-[#f37021]"
                                    checked={formData.isHomeCare}
                                    onChange={e => setFormData({ ...formData, isHomeCare: e.target.checked })}
                                />
                                <label htmlFor="industryCheckbox" className="text-sm font-medium text-gray-700 cursor-pointer flex items-center gap-2">
                                    <Briefcase size={16} className="text-[#1d5eed]" />
                                    I am currently working in the home care industry.
                                </label>
                            </div>
                        )}

                        <Button type="submit" className="w-full text-lg" disabled={isSubmitting}>
                            {isSubmitting ? (
                                <>
                                    <Loader2 className="animate-spin" size={20} /> Submitting...
                                </>
                            ) : (
                                "Submit Nomination"
                            )}
                        </Button>

                        {/* Error Message */}
                        {errorMsg && (
                            <div className="mt-4 bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r">
                                <div className="flex items-center">
                                    <AlertCircle className="text-amber-500 mr-2" size={20} />
                                    <p className="text-amber-700 font-medium">{errorMsg}</p>
                                </div>
                            </div>
                        )}

                    </form>
                </Card>
            </div>
        </div>
    );
};

// --- MODIFIED: VoteView now uses filteredNominees and controls search input ---
const VoteView = ({ setView, filteredNominees, onInitiateVote, isLoading, searchTerm, setSearchTerm, votedNomineeIds }) => (
    <div className="py-12 px-6 lg:px-12 bg-gray-50 min-h-screen">
        <div className="max-w-7xl mx-auto">
            <div className="flex flex-col md:flex-row justify-between items-end mb-8 gap-4">
                <div>
                    <button onClick={() => setView('home')} className="flex items-center gap-2 text-gray-500 hover:text-[#f37021] mb-4 font-medium">
                        <ChevronRight className="rotate-180" size={20} /> Back to Home
                    </button>
                    <h2 className="text-3xl font-bold" style={{ color: THEME.colors.deepBlue }}>Vote for Excellence</h2>
                    <p className="text-gray-600 mt-2">Support your colleagues by voting for their outstanding contributions.</p>
                </div>

                <div className="relative">
                    <input
                        type="text"
                        placeholder="Search nominees by name or reason..."
                        className="pl-10 pr-4 py-2 rounded-full border border-gray-300 focus:outline-none focus:border-[#f37021] w-full md:w-64"
                        value={searchTerm}
                        onChange={(e) => setSearchTerm(e.target.value)}
                    />
                    <Search className="absolute left-3 top-2.5 text-gray-400" size={18} />
                </div>
            </div>

            {isLoading ? (
                <div className="flex flex-col items-center justify-center py-20 h-64 text-gray-500">
                    <Loader2 className="w-12 h-12 mb-4 animate-spin text-[#f37021]" />
                    <p className="font-medium text-lg">Loading Nominations from Airtable...</p>
                </div>
            ) : filteredNominees.length === 0 && searchTerm ? (
                <div className="text-center py-20 bg-white rounded-lg shadow-sm border border-gray-100">
                    <Search className="w-16 h-16 mx-auto text-gray-300 mb-4" />
                    <h3 className="text-xl font-bold text-gray-700">No matching nominees found.</h3>
                    <p className="text-gray-500 mt-2">Try a different name or search term.</p>
                </div>
            ) : filteredNominees.length === 0 && !searchTerm ? (
                <div className="text-center py-20 bg-white rounded-lg shadow-sm border border-gray-100">
                    <UserPlus className="w-16 h-16 mx-auto text-gray-300 mb-4" />
                    <h3 className="text-xl font-bold text-gray-700">No Nominations Yet</h3>
                    <p className="text-gray-500 mt-2 mb-6">Be the first to recognize a colleague!</p>
                    <Button onClick={() => setView('nomination-type')}>Nominate Someone</Button>
                </div>
            ) : (
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {filteredNominees.map((nominee) => {
                        const categoryColor = CATEGORIES.find(c => c.name === nominee.category)?.color || THEME.colors.deepBlue;
                        const imageSrc = nominee.image || "https://placehold.co/150x150/dadadf/08193e?text=No+Photo";

                        // Determine if the user has voted for this nominee based on confirmed history
                        const hasVoted = votedNomineeIds.includes(nominee.id);

                        return (
                            <Card key={nominee.id} className="flex flex-col h-full">
                                <div className="relative aspect-square overflow-hidden bg-gray-200">
                                    <img
                                        src={imageSrc}
                                        alt={nominee.name}
                                        className="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                                        onError={(e) => { e.target.onerror = null; e.target.src = "https://placehold.co/400x400/dadadf/08193e?text=Photo+Missing"; }}
                                    />
                                    <div className="absolute top-4 left-4">
                                        <Badge color={categoryColor}>{nominee.category}</Badge>
                                    </div>
                                    {nominee.isNew && (
                                        <div className="absolute top-4 right-4 bg-[#f37021] text-white text-xs font-bold px-2 py-1 rounded shadow-md animate-pulse">
                                            NEW
                                        </div>
                                    )}
                                </div>

                                <div className="p-6 flex-1 flex flex-col">
                                    <div className="flex justify-between items-start mb-2">
                                        <h3 className="text-xl font-bold" style={{ color: THEME.colors.deepBlue }}>{nominee.name}</h3>
                                    </div>

                                    <p className="text-gray-600 text-sm mb-6 flex-1 line-clamp-3">
                                        "{nominee.description}"
                                    </p>

                                    <div className="flex items-center justify-between pt-4 border-t border-gray-100">
                                        <div className="flex items-center gap-2 text-gray-500 font-medium">
                                            <Award size={18} className="text-[#ffaa05]" />
                                            <span>{nominee.votes} Votes</span>
                                        </div>

                                        <button
                                            onClick={() => onInitiateVote(nominee.id)}
                                            disabled={hasVoted}
                                            className={`flex items-center gap-2 px-4 py-2 rounded-full text-sm font-bold transition-all ${hasVoted
                                                    ? 'bg-green-100 text-green-700 cursor-default'
                                                    : 'bg-gray-100 text-gray-600 hover:bg-[#f37021] hover:text-white'
                                                }`}
                                        >
                                            {hasVoted ? (
                                                <>Voted <Check size={16} /></>
                                            ) : (
                                                <>Vote <ThumbsUp size={16} /></>
                                            )}
                                        </button>
                                    </div>
                                </div>
                            </Card>
                        );
                    })}
                </div>
            )}
        </div>
    </div>
);

// SuccessView MODIFIED: Removed MicrosoftFormEmbed logic and component reference
const SuccessView = ({ setView, isHomeCare, userEmail }) => {

    const successMessage = isHomeCare
        ? `Since you are in the home care industry, we have also successfully subscribed ${userEmail} to our results and updates list.`
        : `Your nomination has been successfully submitted. We appreciate your input!`;

    return (
        <div className="min-h-screen flex items-center justify-center bg-gray-50 px-6 py-12">
            <Card className="max-w-md w-full p-8 text-center">
                <div className="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6 text-green-600">
                    <Check size={40} />
                </div>
                <h2 className="text-2xl font-bold mb-4" style={{ color: THEME.colors.deepBlue }}>
                    {isHomeCare ? "Nomination Submitted!" : "Thank You for Your Nomination!"}
                </h2>
                <p className="text-gray-600 mb-4">
                    {isHomeCare ? "Thank you for your nomination." : "We'll review your submission shortly."}
                </p>
                <div className="p-4 bg-gray-100 rounded-md mb-8 text-sm text-gray-700">
                    {successMessage}
                </div>
                <div className="space-y-3">
                    <Button onClick={() => setView('vote')} className="w-full">
                        Vote for Others
                    </Button>
                    <Button variant="secondary" onClick={() => setView('home')} className="w-full">
                        Return Home
                    </Button>
                </div>
            </Card>
        </div>
    );
};


// --- Main Application ---

export default function AlayaCareAwards() {
    const [view, setView] = useState('home');
    const [nominationType, setNominationType] = useState('other');

    const [nominees, setNominees] = useState([]);
    const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
    const [isSubmitting, setIsSubmitting] = useState(false);
    const [isLoadingNominees, setIsLoadingNominees] = useState(true);
    const [searchTerm, setSearchTerm] = useState('');

    const [nominationError, setNominationError] = useState(null);

    // --- Voting Modal States ---
    const [isVoteModalOpen, setIsVoteModalOpen] = useState(false);
    const [selectedNomineeId, setSelectedNomineeId] = useState(null);
    const [isCheckingVote, setIsCheckingVote] = useState(false);
    const [voteError, setVoteError] = useState(null);
    const [voteCompleted, setVoteCompleted] = useState(false);

    // --- Vote Confirmation States ---
    const [confirmationModal, setConfirmationModal] = useState({ isOpen: false, isSuccess: true, title: '', message: '' });
    const [votedNomineeIds, setVotedNomineeIds] = useState([]); // Stores IDs of nominees the user has confirmed votes for
    const [confirmedVoterEmail, setConfirmedVoterEmail] = useState(null); // Stores the user's email after confirmation

    // Credentials for Airtable
    const AIRTABLE_API_KEY = 'patLkTAV0xeNgmunb.de0cde02e054127c05d560296e895e37c9c0bc31f8b6c695b71cef903783e5c8';
    const BASE_ID = 'appoyGieFsL8edtK1';
    const TABLE_NAME = 'Nominations';
    const VOTING_RECORD_TABLE = 'Voting Record';
    const EMAIL_CONFIRMATIONS_TABLE = 'Email Confirmations';

    // --- Data Filtering Logic ---
    const filteredNominees = nominees.filter(nominee => {
        if (!searchTerm) return true;
        const lowerSearch = searchTerm.toLowerCase();
        return (
            (nominee.name && nominee.name.toLowerCase().includes(lowerSearch)) ||
            (nominee.description && nominee.description.toLowerCase().includes(lowerSearch)) ||
            (nominee.category && nominee.category.toLowerCase().includes(lowerSearch))
        );
    });

    // --- Helper: Fetch Nominations ---
    const fetchNominations = async () => {
        setIsLoadingNominees(true);
        try {
            const sortQuery = 'sort[0][field]=Votes&sort[0][direction]=desc';
            const filterFormula = encodeURIComponent("{Status}='Live'");

            const response = await fetch(`https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(TABLE_NAME)}?${sortQuery}&filterByFormula=${filterFormula}`, {
                headers: {
                    Authorization: `Bearer ${AIRTABLE_API_KEY}`
                }
            });

            if (response.ok) {
                const data = await response.json();
                const fetchedNominees = data.records.map(record => ({
                    id: record.id,
                    name: record.fields["Name"] || "Unknown Name",
                    category: record.fields["Category"] || "Uncategorized",
                    votes: record.fields["Votes"] || 0,
                    image: record.fields["Profile Photo"]?.[0]?.url || null,
                    description: record.fields["Nomination Reason"] || "No description provided.",
                    isNew: false
                }));

                if (fetchedNominees.length > 0) {
                    setNominees(fetchedNominees);
                }
            } else {
                console.error("Airtable Fetch Error:", response.status, response.statusText);
            }
        } catch (error) {
            console.error("Failed to fetch nominees:", error);
        } finally {
            setIsLoadingNominees(false);
        }
    };

    // --- Helper: Load Voter Status ---
    const loadVoterStatus = async (email) => {
        if (!email) return;
        try {
            const filterFormula = encodeURIComponent(`{Voter Email}='${email}'`);
            const response = await fetch(`https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(VOTING_RECORD_TABLE)}?filterByFormula=${filterFormula}`, {
                headers: { Authorization: `Bearer ${AIRTABLE_API_KEY}` }
            });

            if (response.ok) {
                const data = await response.json();
                if (data.records.length > 0) {
                    const record = data.records[0];
                    const votedIds = record.fields["Voted Nominees"] || [];
                    setVotedNomineeIds(votedIds);
                }
            }
        } catch (err) {
            console.error("Failed to load voter status", err);
        }
    };

    // --- Helper: Confirm Vote From Token ---
    const confirmVoteFromToken = async (token) => {
        try {
            // 1. Look up Email Confirmation
            const tokenFormula = encodeURIComponent(`{Confirmation Token}='${token}'`);
            const confirmResponse = await fetch(`https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(EMAIL_CONFIRMATIONS_TABLE)}?filterByFormula=${tokenFormula}`, {
                headers: { Authorization: `Bearer ${AIRTABLE_API_KEY}` }
            });

            if (!confirmResponse.ok) throw new Error("Verification check failed.");
            const confirmData = await confirmResponse.json();

            if (confirmData.records.length === 0) {
                setConfirmationModal({
                    isOpen: true,
                    isSuccess: false,
                    title: 'Invalid Link',
                    message: 'This confirmation link is invalid or has expired.'
                });
                window.history.replaceState({}, '', window.location.pathname);
                return;
            }

            const confirmRecord = confirmData.records[0];
            const { "Voter Email": voterEmail, "Voted For": votedForIds, "Vote Confirmed": isConfirmed } = confirmRecord.fields;
            const nomineeId = votedForIds ? votedForIds[0] : null;

            if (isConfirmed) {
                // Already confirmed, just show success and load state
                setConfirmedVoterEmail(voterEmail);
                await loadVoterStatus(voterEmail);
                setConfirmationModal({
                    isOpen: true,
                    isSuccess: true,
                    title: 'Vote Verified',
                    message: 'Your vote has already been verified and counted.'
                });
                window.history.replaceState({}, '', window.location.pathname);
                return;
            }

            if (!nomineeId) throw new Error("No nominee found associated with this vote.");

            // 2. Fetch Nominee Name for Display
            const nomineeRes = await fetch(`https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(TABLE_NAME)}/${nomineeId}`, {
                headers: { Authorization: `Bearer ${AIRTABLE_API_KEY}` }
            });
            const nomineeData = await nomineeRes.json();
            const nomineeName = nomineeData.fields["Name"] || "the nominee";

            // 3. Find or Create Voting Record
            const voterFormula = encodeURIComponent(`{Voter Email}='${voterEmail}'`);
            const votingRecordRes = await fetch(`https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(VOTING_RECORD_TABLE)}?filterByFormula=${voterFormula}`, {
                headers: { Authorization: `Bearer ${AIRTABLE_API_KEY}` }
            });
            const votingRecordData = await votingRecordRes.json();

            let votingRecordId;
            let currentVotedNominees = [];

            if (votingRecordData.records.length > 0) {
                votingRecordId = votingRecordData.records[0].id;
                currentVotedNominees = votingRecordData.records[0].fields["Voted Nominees"] || [];
            } else {
                // Create new
                const createRes = await fetch(`https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(VOTING_RECORD_TABLE)}`, {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${AIRTABLE_API_KEY}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        records: [{ fields: { "Voter Email": voterEmail } }]
                    })
                });
                const createData = await createRes.json();
                votingRecordId = createData.records[0].id;
            }

            // 4. Update Voting Record (add nominee if not present)
            if (!currentVotedNominees.includes(nomineeId)) {
                const updatedNominees = [...currentVotedNominees, nomineeId];
                await fetch(`https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(VOTING_RECORD_TABLE)}`, {
                    method: 'PATCH',
                    headers: {
                        'Authorization': `Bearer ${AIRTABLE_API_KEY}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        records: [{
                            id: votingRecordId,
                            fields: { "Voted Nominees": updatedNominees }
                        }]
                    })
                });
            }

            // 5. Update Email Confirmation to 'Confirmed'
            await fetch(`https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(EMAIL_CONFIRMATIONS_TABLE)}`, {
                method: 'PATCH',
                headers: {
                    'Authorization': `Bearer ${AIRTABLE_API_KEY}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    records: [{
                        id: confirmRecord.id,
                        fields: {
                            "Vote Confirmed": true,
                            // "Confirmed At": new Date().toISOString() // Optional, assuming field exists
                        }
                    }]
                })
            });

            // 6. Finalize
            setConfirmedVoterEmail(voterEmail);
            await loadVoterStatus(voterEmail);
            setConfirmationModal({
                isOpen: true,
                isSuccess: true,
                title: 'Vote Confirmed!',
                message: `Your vote for ${nomineeName} has been successfully verified.`
            });
            window.history.replaceState({}, '', window.location.pathname);

        } catch (error) {
            console.error("Confirmation error:", error);
            setConfirmationModal({
                isOpen: true,
                isSuccess: false,
                title: 'Confirmation Failed',
                message: 'There was a problem verifying your vote. Please try again or contact support.'
            });
            window.history.replaceState({}, '', window.location.pathname);
        }
    };

    // --- INITIAL LOAD: Fetch Nominees & Check URL Token ---
    useEffect(() => {
        fetchNominations();

        // Check for URL params
        const searchParams = new URLSearchParams(window.location.search);
        const voteAction = searchParams.get('vote');
        const token = searchParams.get('token');

        if (voteAction === 'confirm' && token) {
            confirmVoteFromToken(token);
        }
    }, []);

    // Form State
    const [formData, setFormData] = useState({
        nomineeName: '',
        nomineeEmail: '',
        category: 'Compassion in Care',
        description: '',
        email: '',
        profileImage: null,
        isHomeCare: false
    });

    // --- VOTING LOGIC ---

    // 1. Initiate vote - open modal
    const handleInitiateVote = (id) => {
        setSelectedNomineeId(id);
        setVoteError(null);
        setVoteCompleted(false); // Reset success state
        setIsVoteModalOpen(true);
    };

    // 2. Close modal
    const handleCloseVoteModal = () => {
        setIsVoteModalOpen(false);
        setSelectedNomineeId(null);
        setVoteError(null);
        setVoteCompleted(false); // Reset success state
    };

    // 3. Check for previous vote and Submit
    const handleConfirmVote = async (email) => {
        setIsCheckingVote(true);
        setVoteError(null);

        const nominee = nominees.find(n => n.id === selectedNomineeId);
        if (!nominee) {
            setVoteError("Nominee not found.");
            setIsCheckingVote(false);
            return;
        }

        try {
            // Step A: Check 'Voting Record' table
            const filterFormula = encodeURIComponent(`{Voter Email}='${email}'`);
            const checkResponse = await fetch(`https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(VOTING_RECORD_TABLE)}?filterByFormula=${filterFormula}`, {
                headers: { Authorization: `Bearer ${AIRTABLE_API_KEY}` }
            });

            if (!checkResponse.ok) throw new Error("Failed to check voting record.");

            const checkData = await checkResponse.json();
            const existingRecord = checkData.records[0];

            if (existingRecord) {
                const votedNominees = existingRecord.fields["Voted Nominees"] || [];
                const hasVoted = Array.isArray(votedNominees)
                    ? votedNominees.includes(nominee.id)
                    : false;

                if (hasVoted) {
                    setVoteError("You've already voted for this nominee.");
                    setIsCheckingVote(false);
                    return;
                }
            }

            // --- Use crypto.randomUUID() for Confirmation Token and use a single POST ---
            const confirmationToken = crypto.randomUUID();

            const postResponse = await fetch(`https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(EMAIL_CONFIRMATIONS_TABLE)}`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${AIRTABLE_API_KEY}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    records: [{
                        fields: {
                            "Voter Email": email,
                            "Voted For": [nominee.id],
                            "Confirmation Token": confirmationToken
                        }
                    }]
                })
            });

            if (!postResponse.ok) {
                const err = await postResponse.json();
                console.error(err);
                throw new Error("Failed to create email confirmation record.");
            }

            // Success! (Do NOT optimistically update votes)
            setVoteCompleted(true);

        } catch (error) {
            console.error(error);
            setVoteError("An error occurred while processing your vote. Please try again.");
        } finally {
            setIsCheckingVote(false);
        }
    };


    const submitToHubSpot = async (email, publicImageUrl) => {
        const url = "https://api.hsforms.com/submissions/v3/integration/submit/2702101/e0381353-7ae7-4fe3-825e-5010ec69f531";

        const fields = [
            {
                objectTypeId: "0-1",
                name: 'email',
                value: email
            }
        ];

        if (publicImageUrl) {
            fields.push({
                objectTypeId: "0-1",
                name: 'profile_photo_url',
                value: publicImageUrl
            });
        }

        const body = {
            fields: fields,
            context: {
                pageUri: window.location.href,
                pageName: 'AlayaCare Awards Nomination Form'
            }
        };

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(body)
            });

            if (!response.ok) {
                console.error('HubSpot submission failed:', response.status, response.statusText);
            }
        } catch (error) {
            console.error('Error submitting to HubSpot:', error);
        }
    };

    const checkIfNomineeExists = async (nomineeEmail) => {
        if (!nomineeEmail) return false;
        const filterFormula = encodeURIComponent(`LOWER({Nominee Email})=LOWER('${nomineeEmail}')`);

        try {
            const response = await fetch(`https://api.airtable.com/v0/${BASE_ID}/${encodeURIComponent(TABLE_NAME)}?filterByFormula=${filterFormula}`, {
                headers: {
                    Authorization: `Bearer ${AIRTABLE_API_KEY}`
                }
            });

            if (response.ok) {
                const data = await response.json();
                return data.records && data.records.length > 0;
            }
            return false;
        } catch (error) {
            console.error("Error checking for duplicate nominee:", error);
            return false;
        }
    };

    const submitToAirtable = async (email, nomineeName, nomineeEmail, description, category, publicImageUrl) => {
        const url = `https://api.airtable.com/v0/${BASE_ID}/${TABLE_NAME}`;

        const fields = {
            "Nominator Email": email,
            "Name": nomineeName,
            "Nominee Email": nomineeEmail,
            "Nomination Reason": description,
            "Category": category,
            "Votes": 0,
            "Status": "Draft"
        };

        if (publicImageUrl) {
            fields["Profile Photo"] = [{
                url: publicImageUrl,
                filename: `${nomineeName.replace(/\s+/g, '_')}_photo.png`
            }];
        }

        const body = {
            records: [
                {
                    fields: fields
                }
            ]
        };

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${AIRTABLE_API_KEY}`,
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(body)
            });

            if (!response.ok) {
                const errorData = await response.json();
                console.error('Airtable submission failed:', response.status, errorData);
            }
        } catch (error) {
            console.error('Error submitting to Airtable:', error);
        }
    };

    const handleNominateSubmit = async (e) => {
        e.preventDefault();
        setNominationError(null);
        setIsSubmitting(true);

        // Check for Duplicate Nominee Email
        const exists = await checkIfNomineeExists(formData.nomineeEmail);

        if (exists) {
            setNominationError("This person has already been nominated. Thank you for your enthusiasm.");
            setIsSubmitting(false);
            return;
        }

        const localImageSource = formData.profileImage;
        let finalImageUrl = null;

        if (localImageSource && localImageSource.startsWith('data:')) {
            console.warn("Local image detected. Using placeholder URL.");
            finalImageUrl = "https://placehold.co/400x400/ff0000/ffffff?text=UPLOAD+SERVICE+MISSING";
        } else if (localImageSource) {
            finalImageUrl = localImageSource;
        }

        // Determine the nominator email to use
        // If self-nomination, the nominator is the nominee.
        const nominatorEmailToUse = nominationType === 'self' ? formData.nomineeEmail : formData.email;

        await submitToAirtable(
            nominatorEmailToUse,
            formData.nomineeName,
            formData.nomineeEmail,
            formData.description,
            formData.category,
            finalImageUrl
        );

        if (formData.isHomeCare) {
            // Use the nominator email for subscription
            await submitToHubSpot(nominatorEmailToUse, finalImageUrl);
        }

        // --- REMOVED OPTIMISTIC LOCAL UPDATE ---

        setIsSubmitting(false);
        setView('success');
    };

    const handleViewChange = (newView) => {
        if (view === 'success' && newView !== 'success') {
            setFormData({
                nomineeName: '',
                nomineeEmail: '',
                category: 'Compassion in Care',
                description: '',
                email: '',
                profileImage: null,
                isHomeCare: false
            });
            setNominationError(null);
        }
        setView(newView);
    }

    // --- Header ---
    const Header = () => (
        <header className="bg-white shadow-sm sticky top-0 z-50">
            <div className="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
                <div className="flex items-center cursor-pointer" onClick={() => handleViewChange('home')}>
                    <div className="flex flex-col">
                        <span className="text-2xl font-bold leading-none tracking-tight" style={{ color: THEME.colors.deepBlue }}>AlayaCare</span>
                        <span className="text-[10px] font-semibold tracking-widest uppercase text-gray-500">Awards</span>
                    </div>
                </div>

                <nav className="hidden md:flex items-center gap-8">
                    <button onClick={() => handleViewChange('home')} className={`font-medium hover:text-[#f37021] transition-colors ${view === 'home' ? 'text-[#f37021]' : 'text-[#08193e]'}`}>Home</button>
                    <button onClick={() => handleViewChange('nomination-type')} className={`font-medium hover:text-[#f37021] transition-colors ${view === 'nominate' || view === 'nomination-type' ? 'text-[#f37021]' : 'text-[#08193e]'}`}>Nominate</button>
                    <button onClick={() => handleViewChange('vote')} className={`font-medium hover:text-[#f37021] transition-colors ${view === 'vote' ? 'text-[#f37021]' : 'text-[#08193e]'}`}>Vote</button>
                    <Button onClick={() => handleViewChange('nomination-type')} className="py-2 px-4 text-sm">Get Started</Button>
                </nav>

                <button className="md:hidden text-gray-600" onClick={() => setMobileMenuOpen(!mobileMenuOpen)}>
                    {mobileMenuOpen ? <X /> : <Menu />}
                </button>
            </div>

            {mobileMenuOpen && (
                <div className="md:hidden absolute top-20 left-0 w-full bg-white shadow-lg border-t z-50 flex flex-col p-4 animate-fade-in-down">
                    <button onClick={() => { handleViewChange('home'); setMobileMenuOpen(false); }} className="p-4 text-left font-medium border-b hover:bg-gray-50 text-[#08193e]">Home</button>
                    <button onClick={() => { handleViewChange('nomination-type'); setMobileMenuOpen(false); }} className="p-4 text-left font-medium border-b hover:bg-gray-50 text-[#08193e]">Nominate</button>
                    <button onClick={() => { handleViewChange('vote'); setMobileMenuOpen(false); }} className="p-4 text-left font-medium border-b hover:bg-gray-50 text-[#08193e]">Vote</button>
                </div>
            )}
        </header>
    );

    return (
        <div className="min-h-screen flex flex-col font-sans text-slate-800 bg-[#fcfcfc]">
            <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        body { font-family: ${THEME.fonts.main}; }
      `}</style>

            {/* Header component renders the navbar */}
            <Header />

            <main className="flex-1">
                {view === 'home' && <HomeView setView={handleViewChange} />}
                {view === 'nomination-type' && <NominationTypeView setView={setView} setNominationType={setNominationType} />}
                {view === 'nominate' && (
                    <NominateView
                        setView={handleViewChange}
                        formData={formData}
                        setFormData={setFormData}
                        handleNominateSubmit={handleNominateSubmit}
                        isSubmitting={isSubmitting}
                        errorMsg={nominationError}
                        nominationType={nominationType}
                    />
                )}
                {view === 'vote' && (
                    <VoteView
                        setView={handleViewChange}
                        filteredNominees={filteredNominees}
                        onInitiateVote={handleInitiateVote}
                        isLoading={isLoadingNominees}
                        searchTerm={searchTerm}
                        setSearchTerm={setSearchTerm}
                        votedNomineeIds={votedNomineeIds} // Pass confirmed vote history
                    />
                )}
                {view === 'success' && (
                    <SuccessView
                        setView={handleViewChange}
                        isHomeCare={formData.isHomeCare}
                        userEmail={formData.email || formData.nomineeEmail}
                    />
                )}
            </main>

            {/* Render Vote Modal */}
            <VoteModal
                isOpen={isVoteModalOpen}
                onClose={handleCloseVoteModal}
                nominee={nominees.find(n => n.id === selectedNomineeId)}
                onSubmit={handleConfirmVote}
                isChecking={isCheckingVote}
                errorMsg={voteError}
                voteCompleted={voteCompleted}
            />

            {/* Render Vote Confirmation Result Modal */}
            <ConfirmationResultModal
                isOpen={confirmationModal.isOpen}
                onClose={() => setConfirmationModal({ ...confirmationModal, isOpen: false })}
                title={confirmationModal.title}
                message={confirmationModal.message}
                isSuccess={confirmationModal.isSuccess}
                onViewVotes={() => {
                    setConfirmationModal({ ...confirmationModal, isOpen: false });
                    setView('vote');
                }}
            />

            {/* Footer */}
            <footer style={{ backgroundColor: THEME.colors.deepBlue }} className="text-white py-12 px-6">
                <div className="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
                    <div className="text-center md:text-left">
                        <h4 className="text-xl font-bold mb-2">AlayaCare</h4>
                        <p className="text-gray-400 text-sm">Better technology. Better outcomes.</p>
                    </div>
                    <div className="flex gap-6 text-sm text-gray-300">
                        <a href="#" className="hover:text-white transition-colors">Privacy Policy</a>
                        <a href="#" className="hover:text-white transition-colors">Terms of Service</a>
                        <a href="#" className="hover:text-white transition-colors">Contact Support</a>
                    </div>
                    <div className="text-xs text-gray-500">
                        © 2025 AlayaCare. All rights reserved.
                    </div>
                </div>
            </footer>
        </div>
    );
}